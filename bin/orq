#!/usr/bin/env bash
# orq: a thin launcher. The program is src/cli.ts (TypeScript, Effect, Bun).
# `orq guard` runs before every tool call, so it skips the Effect CLI and starts fast.
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
[ "${1:-}" = guard ] && exec bun "$ROOT/src/guard/main.ts"
exec bun "$ROOT/src/cli.ts" "$@"
