#!/usr/bin/env bash
# orq: the mechanics of orqestrai. Task ids, state, worktrees, zellij tabs.
# The workflow lives in skills/. This script does not decide. It only does.
set -euo pipefail

ORQ_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
ORQ_HOME="${ORQ_HOME:-$HOME/.orqestrai}"
DB="$ORQ_HOME/state.db"
SESSION="${ORQ_ZELLIJ_SESSION:-orq}"
MODEL="${ORQ_SESSION_MODEL:-opus}"
STEPS=(triage plan impl verify learn ship)
STATUSES=("TODO" "IN PROGRESS" "WAITING FOR ME" "BLOCKED" "MERGED")

die() { echo "orq: $*" >&2; exit 1; }
sql() { sqlite3 -bail "$DB" "$@"; }
q() { local s=${1//\'/\'\'}; printf "'%s'" "$s"; }
in_list() { local x=$1; shift; for e in "$@"; do [ "$e" = "$x" ] && return 0; done; return 1; }

init_db() {
  mkdir -p "$ORQ_HOME"
  sql <<'SQL'
CREATE TABLE IF NOT EXISTS tasks(
  id TEXT PRIMARY KEY,
  repo TEXT NOT NULL,
  title TEXT NOT NULL,
  branch TEXT NOT NULL,
  worktree TEXT NOT NULL,
  step TEXT NOT NULL DEFAULT 'triage',
  status TEXT NOT NULL DEFAULT 'TODO',
  pr_url TEXT,
  slack_thread TEXT,
  created_at TEXT NOT NULL DEFAULT (datetime('now')),
  updated_at TEXT NOT NULL DEFAULT (datetime('now')));
CREATE TABLE IF NOT EXISTS events(
  task_id TEXT NOT NULL,
  at TEXT NOT NULL DEFAULT (datetime('now')),
  kind TEXT NOT NULL,
  detail TEXT);
SQL
}

base_branch() {
  local root=$1 cfg="$1/.orqestrai/config.toml" b=""
  [ -f "$cfg" ] && b=$(sed -n 's/^base_branch *= *"\(.*\)"/\1/p' "$cfg" | head -1)
  [ -n "$b" ] || b=$(git -C "$root" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##') || true
  echo "${b:-main}"
}

slugify() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | cut -c1-40 | sed 's/^-*//; s/-*$//'
}

open_tab() {
  local id=$1 wt=$2
  local cmd=(claude --model "$MODEL" "/orqestrai:task $id")
  if [ -n "${ZELLIJ:-}" ]; then
    zellij action new-tab --name "orq-$id" --cwd "$wt" -- "${cmd[@]}" >/dev/null
    echo "opened zellij tab orq-$id"
  elif zellij list-sessions --short 2>/dev/null | grep -qx "$SESSION"; then
    zellij --session "$SESSION" action new-tab --name "orq-$id" --cwd "$wt" -- "${cmd[@]}" >/dev/null
    echo "opened tab orq-$id in zellij session $SESSION (attach: zellij attach $SESSION)"
  else
    echo "no zellij session; start the task with:"
    echo "  cd $wt && $(printf '%q ' "${cmd[@]}")"
  fi
}

cmd_new() {
  local request=${1:-}
  [ -n "$request" ] || die 'usage: orq new "<request>"'
  local root repo base n id slug branch wt dir
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not in a git repository"
  repo=$(basename "$root")
  base=$(base_branch "$root")
  git -C "$root" rev-parse --verify --quiet "$base" >/dev/null || die "base branch '$base' not found"
  n=$(sql "SELECT IFNULL(MAX(CAST(substr(id, 3) AS INTEGER)), 0) + 1 FROM tasks;")
  id=$(printf 'T-%04d' "$n")
  slug=$(slugify "$request"); slug=${slug:-task}
  branch="orq/$id-$slug"
  wt="$ORQ_HOME/worktrees/$repo/$id-$slug"

  git -C "$root" worktree add --quiet -b "$branch" "$wt" "$base"
  dir="$wt/.orqestrai/tasks/$id"
  mkdir -p "$dir"
  printf -- '---\nid: %s\ncreated: %s\n---\n\n%s\n' "$id" "$(date -u +%FT%TZ)" "$request" > "$dir/REQUEST.md"

  sql "INSERT INTO tasks(id, repo, title, branch, worktree) VALUES($(q "$id"), $(q "$root"), $(q "$request"), $(q "$branch"), $(q "$wt"));
       INSERT INTO events(task_id, kind, detail) VALUES($(q "$id"), 'created', $(q "$branch from $base"));"
  echo "$id  $branch  $wt"
  open_tab "$id" "$wt"
}

cmd_state() {
  [ $# -ge 3 ] || die 'usage: orq state <id> <step> <status> [note]'
  local id=$1 step=$2 status=$3 note=${4:-}
  in_list "$step" "${STEPS[@]}" || die "unknown step '$step' (${STEPS[*]})"
  in_list "$status" "${STATUSES[@]}" || die "unknown status '$status'"
  [ "$(sql "SELECT COUNT(*) FROM tasks WHERE id = $(q "$id");")" = 1 ] || die "no task $id"
  sql "UPDATE tasks SET step = $(q "$step"), status = $(q "$status"), updated_at = datetime('now') WHERE id = $(q "$id");
       INSERT INTO events(task_id, kind, detail) VALUES($(q "$id"), $(q "$step: $status"), $(q "$note"));"
}

cmd_show() {
  [ $# -eq 1 ] || die 'usage: orq show <id>'
  local out
  out=$(sql -line "SELECT * FROM tasks WHERE id = $(q "$1");")
  [ -n "$out" ] || die "no task $1"
  echo "$out"
  echo
  sql -column "SELECT at, kind, detail FROM events WHERE task_id = $(q "$1") ORDER BY rowid DESC LIMIT 10;"
}

cmd_file() {
  [ $# -eq 2 ] || die 'usage: orq file <id> <BRIEF|RESEARCH|SPEC>'
  local id=$1 name=$2 tpl root out
  tpl="$ORQ_ROOT/templates/$name.md"
  [ -f "$tpl" ] || die "no template '$name' (have: $(cd "$ORQ_ROOT/templates" && ls | sed 's/\.md$//' | tr '\n' ' '))"
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not in a git repository"
  out="$root/.orqestrai/tasks/$id/$name.md"
  [ -d "$(dirname "$out")" ] || die "no task folder for $id here; are you in its worktree?"
  [ -e "$out" ] && die "$out exists; edit it instead"
  sed "s/{{id}}/$id/g" "$tpl" > "$out"
  echo "$out"
}

cmd_ls() {
  sql -column -header "SELECT id, step, status, title, updated_at FROM tasks ORDER BY id;"
}

usage() {
  cat <<'EOF'
orq new "<request>"                 new task: id, branch, worktree, zellij tab
orq state <id> <step> <status> [n]  record step and status
orq show <id>                       one task and its last events
orq file <id> <NAME>                new task file from templates/NAME.md
orq ls                              all tasks

steps:    triage plan impl verify learn ship
statuses: TODO | IN PROGRESS | WAITING FOR ME | BLOCKED | MERGED
EOF
}

command -v sqlite3 >/dev/null || die "sqlite3 is required"
init_db
case "${1:-}" in
  new)   shift; cmd_new "$@" ;;
  state) shift; cmd_state "$@" ;;
  show)  shift; cmd_show "$@" ;;
  file)  shift; cmd_file "$@" ;;
  ls)    shift; cmd_ls ;;
  *)     usage ;;
esac
