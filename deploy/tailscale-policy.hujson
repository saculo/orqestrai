// The tailnet policy: paste it into login.tailscale.com, Access controls (it replaces the
// default allow-all). Your own devices reach everything. VPS1, where Claude runs, reaches only
// orq serve's port on VPS2; it cannot reach OpenBao, Kubernetes or VPS2's SSH.
{
  "tagOwners": {
    "tag:vps1": ["autogroup:admin"],
    "tag:vps2": ["autogroup:admin"],
    "tag:k8s-operator": [],
    "tag:k8s": ["tag:k8s-operator"], // orq-server and other Services the operator exposes
  },
  "grants": [
    { "src": ["autogroup:member"], "dst": ["*"], "ip": ["*"] },
    { "src": ["tag:vps1"], "dst": ["tag:k8s"], "ip": ["tcp:7400"] },
  ],
  "ssh": [
    { "action": "accept", "src": ["autogroup:member"], "dst": ["tag:vps1", "tag:vps2"], "users": ["autogroup:nonroot", "root"] },
  ],
}
