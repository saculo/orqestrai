    "test": "bun test",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.2",
    "@effect/sql-sqlite-bun": "4.1.2",
    "effect": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shell-quote": "1.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/shell-quote": "1.7.5",
    "typescript": "6.0.3"
  },
  "overrides": {
    "effect": "4.1.2",
    "@effect/platform-node-shared": "4.1.2"
  }
