{
  "name": "orqestrai",
  "version": "0.8.0",
  "description": "An orchestrated software factory with human gates: the orq CLI and server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saculo/orqestrai.git"
  },
  "bin": {
    "orq": "src/main.ts"
  },
  "files": [
    "src",
    "templates"
  ],
